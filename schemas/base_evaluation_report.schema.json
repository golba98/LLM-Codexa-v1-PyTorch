{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codexa base checkpoint evaluation report",
  "type": "object",
  "required": [
    "checkpoint", "checkpoint_optimizer_step", "tokenizer_sha256",
    "prompt_suite_sha256", "source_validation",
    "weighted_source_validation_loss", "aggregate_generation_metrics", "samples"
  ],
  "properties": {
    "source_validation": {
      "type": "object",
      "required": ["fineweb_edu", "wikipedia"]
    },
    "weighted_source_validation_loss": {"type": "number"},
    "aggregate_generation_metrics": {
      "type": "object",
      "required": [
        "average_completion_length", "premature_eos_rate",
        "maximum_length_rate", "mean_repeated_4gram_rate",
        "maximum_longest_repeated_span", "mean_distinct_2",
        "mean_distinct_3", "mean_prompt_copy_rate",
        "invalid_unicode_count", "malformed_token_count", "human_scores"
      ]
    },
    "samples": {"type": "array", "minItems": 10}
  },
  "additionalProperties": true
}
