{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexa.local/schemas/production-run-manifest-v1.json",
  "title": "Codexa v1 production run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_uuid", "run_name", "git_revision", "created_at_utc",
    "architecture", "optimization", "data", "tokenizer", "packing",
    "milestones", "environment", "acceptance_thresholds_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_uuid": {"type": "string", "format": "uuid"},
    "run_name": {"type": "string", "minLength": 1},
    "git_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "architecture": {
      "type": "object",
      "required": ["config_sha256", "parameter_count", "vocabulary_size", "context_length", "tied_embeddings", "dropout", "initialization"],
      "properties": {
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "parameter_count": {"type": "integer", "const": 921773568},
        "vocabulary_size": {"type": "integer", "enum": [8192, 16384]},
        "context_length": {"type": "integer", "const": 2048},
        "tied_embeddings": {"type": "boolean"},
        "dropout": {"type": "number", "minimum": 0},
        "initialization": {"type": "object"}
      },
      "additionalProperties": true
    },
    "optimization": {
      "type": "object",
      "required": ["optimizer", "micro_batch_size", "gradient_accumulation", "sequences_per_optimizer_step", "tokens_per_optimizer_step", "peak_learning_rate", "minimum_learning_rate", "warmup_tokens", "decay_tokens", "total_token_budget", "weight_decay", "adam_betas", "adam_epsilon", "gradient_clip_norm", "precision", "activation_checkpointing", "attention_backend", "compiler", "weight_decay_exclusions"],
      "additionalProperties": true
    },
    "data": {
      "type": "object",
      "required": ["data_manifest_sha256", "fineweb_token_percentage", "wikipedia_token_percentage", "achieved_source_tokens", "split_seed", "mixture_sampler_state_version"],
      "additionalProperties": true
    },
    "tokenizer": {
      "type": "object",
      "required": ["tokenizer_sha256", "vocabulary_size", "special_token_ids", "bakeoff_report_sha256"],
      "additionalProperties": true
    },
    "packing": {"type": "object"},
    "milestones": {
      "type": "object",
      "required": ["evaluation_tokens", "generation_tokens", "checkpoint_tokens"],
      "additionalProperties": true
    },
    "environment": {
      "type": "object",
      "required": ["python", "pytorch", "cuda", "nvidia_driver", "operating_system", "gpu_model"],
      "additionalProperties": true
    },
    "acceptance_thresholds_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
