{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codexa token accounting report",
  "type": "object",
  "required": ["schema_version", "seed", "tokenizer_sha256", "sources", "mixture", "packing"],
  "properties": {
    "schema_version": {"const": 1},
    "seed": {"type": "integer", "minimum": 0},
    "tokenizer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sources": {
      "type": "object",
      "patternProperties": {
        ".+": {
          "type": "object",
          "required": ["documents", "content_tokens", "stored_tokens", "mean_document_tokens", "p50_document_tokens", "p95_document_tokens", "p99_document_tokens", "truncated_tokens", "discarded_trailing_tokens"],
          "additionalProperties": false
        }
      }
    },
    "mixture": {
      "type": "object",
      "required": ["requested_percentages", "achieved_percentages", "documents_by_source", "tokens_by_source", "repeated_documents", "sampler_state_sha256"],
      "additionalProperties": true
    },
    "packing": {"type": "object"}
  },
  "additionalProperties": false
}
